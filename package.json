{
  "name": "perfectplay-scaffold",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~56.0.8",
    "expo-av": "^16.0.8",
    "expo-constants": "^56.0.16",
    "expo-linking": "^56.0.13",
    "expo-router": "^56.2.8",
    "expo-speech": "^56.0.3",
    "expo-status-bar": "^56.0.4",
    "firebase": "^12.14.0",
    "nativewind": "^4.2.4",
    "pako": "^2.1.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "tailwindcss": "3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/pako": "^2.0.4",
    "@types/react": "~19.2.2",
    "jest": "29",
    "jest-expo": "^56.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|pako|zustand|firebase|@firebase)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "stores/**/*.ts",
      "voice/utils/**/*.ts",
      "components/**/*.tsx",
      "!**/*.d.ts"
    ]
  },
  "private": true
}
